{
  "name": "Minimal Clean",
  "version": "1.1.0",
  "author": "NeoCab Team",
  "style": "minimal",
  "description": "Clean, modern, flat design with subtle accents. Inspired by Windows Fluent Design",
  "colors": {
    "primary": "#0078d4",
    "secondary": "#f5f5f5",
    "accent": "#00b7c3",
    "text": "#333333",
    "background": "#ffffff",
    "surface": "#f0f0f0",
    "border": "#e0e0e0",
    "highlight": "#0078d4",
    "success": "#107c10",
    "warning": "#ff8c00",
    "error": "#d13438"
  },
  "fonts": {
    "ui": "Segoe UI",
    "title": "Segoe UI",
    "subtitle": "Segoe UI",
    "mono": "Consolas",
    "google_font": "Inter"
  },
  "background": {
    "type": "color",
    "color": "#ffffff",
    "gradient": null,
    "image": null,
    "video": null,
    "opacity": 1.0,
    "blur": 0,
    "overlay_color": null
  },
  "layout": {
    "system_view": "list",
    "game_view": "compact",
    "wheel_style": "hidden",
    "transition": "fade",
    "animation_speed": 200,
    "easing": "linear"
  },
  "wheel": {
    "item_size": 90,
    "item_spacing": 8,
    "animation_duration": 200,
    "selected_color": "#0078d4",
    "unselected_color": "#e0e0e0",
    "selected_scale": 1.05,
    "glow_selected": false
  },
  "media": {
    "video_enabled": true,
    "video_loop": true,
    "snap_type": "screenshot",
    "marquee_enabled": false,
    "wheel_enabled": false,
    "box_art_enabled": true
  },
  "sounds": {
    "navigate": "nav.wav",
    "select": "select.wav",
    "back": "back.wav",
    "coin": "coin.wav",
    "start": "start.wav"
  },
  "effects": {
    "scanlines": false,
    "crt_curve": 0,
    "glow_intensity": 0,
    "shadow_enabled": false,
    "vignette": 0.0,
    "noise": 0.0,
    "blur_unselected": 0
  },
  "overlay": {
    "coin_position": "top-left",
    "timer_position": "bottom-left",
    "stats_opacity": 0.6,
    "animation_style": "instant"
  }
}
