{
  "name": "Neon Future",
  "version": "1.0.0",
  "author": "NeoCab Team",
  "description": "Vibrant neon colors with gradients and glow effects, cyberpunk inspired",
  "colors": {
    "primary": "#ff00ff",
    "secondary": "#0d0d0d",
    "accent": "#00ffff",
    "text": "#ffffff",
    "background": "#0a0a0a",
    "surface": "#1a0a1a",
    "border": "#ff00ff",
    "highlight": "#00ffff",
    "success": "#00ff00",
    "warning": "#ffcc00",
    "error": "#ff0066"
  },
  "fonts": {
    "ui": "Verdana",
    "title": "Impact",
    "subtitle": "Verdana",
    "mono": "Consolas"
  },
  "layout": {
    "system_view": "grid",
    "game_view": "full",
    "wheel_style": "flat",
    "transition": "fade",
    "animation_speed": 400,
    "easing": "easeOutQuad"
  },
  "media": {
    "video_enabled": true,
    "video_loop": true,
    "snap_type": "video",
    "marquee_enabled": true,
    "wheel_enabled": true,
    "box_art_enabled": true
  },
  "sounds": {
    "navigate": "nav.wav",
    "select": "select.wav",
    "back": "back.wav",
    "coin": "coin.wav",
    "start": "start.wav"
  },
  "effects": {
    "scanlines": false,
    "crt_curve": 0,
    "glow_intensity": 1.0,
    "shadow_enabled": true
  }
}
