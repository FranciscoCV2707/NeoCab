{
  "version": "1.0",
  "name": "Neon Future Layout",
  "components": {
    "system_grid": {
      "type": "grid",
      "position": { "x": "center", "y": "center" },
      "size": { "width": "90%", "height": "70%" },
      "columns": 4,
      "item_size": { "width": 250, "height": 150 },
      "gap": 20,
      "animation": {
        "onFocus": { "scale": 1.1, "glow": 1.0, "duration": 250 },
        "onBlur": { "scale": 1.0, "glow": 0.3, "duration": 250 }
      }
    },
    "game_list": {
      "type": "list",
      "position": { "x": 100, "y": 80 },
      "size": { "width": 500, "height": 700 },
      "item_height": 50,
      "visible_items": 12
    },
    "preview_panel": {
      "type": "panel",
      "position": { "x": 650, "y": 80 },
      "size": { "width": 1200, "height": 700 },
      "elements": [
        { "type": "video", "position": { "x": 0, "y": 0 }, "size": { "width": "100%", "height": 450 } },
        { "type": "text", "field": "title", "position": { "x": 0, "y": 470 }, "font": "title" },
        { "type": "text", "field": "description", "position": { "x": 0, "y": 540 }, "font": "ui" },
        { "type": "metadata", "fields": ["year", "developer", "genre", "players"], "position": { "x": 0, "y": 620 } }
      ]
    },
    "status_bar": {
      "type": "bar",
      "position": { "x": 0, "y": "bottom" },
      "size": { "width": "100%", "height": 40 },
      "elements": [
        { "type": "text", "field": "credits", "align": "left" },
        { "type": "text", "field": "timer", "align": "center" },
        { "type": "text", "field": "clock", "align": "right" }
      ]
    }
  }
}
